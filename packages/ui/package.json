{
  "name": "@blurrow/ui",
  "version": "0.1.0",
  "description": "tactile react components: buttons you want to press, fields you want to fill in.",
  "license": "MIT",
  "author": "manyports (https://manyports.com)",
  "homepage": "https://manyports.com",
  "keywords": ["react", "components", "ui", "tailwindcss", "design-system"],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "tsup && cp ../../components/ui/styles.css dist/styles.css",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsup": "^8.5.0",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  }
}
